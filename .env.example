DATABASE_URL="postgresql+asyncpg://db_user:db_password@127.0.0.1:5432/example_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true

# 启用登录前，生成独立的随机密钥并填入本地 .env。
# JWT_SECRET_KEY=
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
AUTH_SESSION_LIFETIME_SECONDS=2592000

# 认证接口需要 Redis；留空时仅启动不依赖 Redis 的功能。仅密码认证时保留密码前的冒号。
# 有 ACL 用户和密码：redis://username:password@host:6379/0
# 服务端启用 TLS 时使用 rediss://；用户名和密码中的特殊字符需做 URL 编码。
# URL 末尾是 Redis 逻辑数据库编号：/0 对应 db0，/2 对应 db2，按实际使用的库修改。
REDIS_URL="redis://:your_password@127.0.0.1:6379/0"
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_COMMAND_TIMEOUT_SECONDS=2
REDIS_MAX_CONNECTIONS=20
